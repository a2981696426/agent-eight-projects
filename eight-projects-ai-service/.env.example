# 大模型：任何兼容 OpenAI Chat Completions 协议的服务
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-key
LLM_MODEL_FAST=deepseek-flash
LLM_MODEL_REASONING=deepseek-flash

# 备用 provider（可选）：任何兼容 OpenAI 协议的端点；主 provider 超时/429/5xx 重试用尽或熔断时自动切换
# LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=gpt-4o-mini

# 高可用参数：连续失败几次熔断、熔断冷却毫秒、同 provider 最大重试次数、单次调用超时
LLM_CIRCUIT_FAILURES=3
LLM_CIRCUIT_COOLDOWN_MS=30000
LLM_MAX_RETRIES=1
LLM_TIMEOUT_MS=60000

# LLM_MOCK=1 时使用离线确定性假模型（无网络演示 / e2e），不与真实 provider 混用
# LLM_MOCK=0

# 会话 Cookie 签名密钥（生产务必更换，≥32 字符）
SESSION_SECRET=change-me-to-a-random-32-plus-character-secret

# 服务端口
API_PORT=8787
WEB_PORT=5173

# 生产模式：SERVE_WEB=1 时 API 直接托管 apps/web/dist（先 pnpm build），单端口部署
# SERVE_WEB=0

# 数据目录（相对 apps/api）；PGlite 数据落在 DATA_DIR/pglite
DATA_DIR=../../data

# 数据库：留空 = PGlite 进程内 Postgres（本机零依赖）；生产填 PostgreSQL 连接串
# docker-compose 默认：postgres://eight:${POSTGRES_PASSWORD}@postgres:5432/eight（compose 会自动注入，本地开发留空）
DATABASE_URL=
# docker-compose 里 postgres 容器的口令（生产必改）
POSTGRES_PASSWORD=eight

# 人工工作日历（预计人工响应时窗按此计算，本地时区；容器需 TZ=Asia/Shanghai）
WORK_HOURS=09:00-18:00
WORK_DAYS=1,2,3,4,5
# HOLIDAYS=2026-10-01,2026-10-02,2026-10-03

# DMS 适配器：mock（模拟，默认）| real（接口可得后实现）
DMS_MODE=mock

# 电商平台只读业务数据（CS-018）：TAOBAO_MODE=sandbox（默认，内置样例可注入故障）| live（淘宝开放平台 TOP）| off
# live 需企业认证通过后创建应用并取得商家授权：TAOBAO_APP_KEY / TAOBAO_APP_SECRET / TAOBAO_SESSION（access token）
TAOBAO_MODE=sandbox
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=
# TAOBAO_API_URL=https://eco.taobao.com/router/rest

# 知识向量检索（CS-017）：EMBEDDING_PROVIDER=hunyuan（首选，同云）| bailian（备用）| openai-compat | mock（本机默认，词法哈希）| off
# hunyuan 默认端点 https://api.hunyuan.cloud.tencent.com/v1 模型 hunyuan-embedding 1024 维；bailian 默认 text-embedding-v4
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
EMBEDDING_DIMS=1024

# 微信公众号 / 测试号（服务器地址填 https://<域名>/api/channels/wechat/webhook）
# 未填 AppID/Secret 或 WECHAT_MOCK=1 时适配器为 mock：不出网，发送记录见 GET /api/channels/wechat/mock/sent
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TOKEN=change-me-wechat-token
WECHAT_AES_KEY=
WECHAT_MOCK=1

# P0 轮值告警（CS-008H / ADR-0035）：off 关闭；mock 本机/演练写回执；wecom 企业微信群机器人
# 只有取得投递回执后才对访客说「已优先通知专人」；15 自然分钟未确认沿花名册升级
ONCALL_MODE=mock
ONCALL_ROSTER=值班A,售后负责人,质量值班
# ONCALL_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key
