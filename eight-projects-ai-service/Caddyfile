# 入口：Caddy（TLS 自动签发）→ API 蓝绿双副本
# SITE_ADDRESS 由 compose 注入：默认 ":80"（本机/内网试点）；ICP 通过后设 SITE_ADDRESS=cs.example.com 即自动 HTTPS。
{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# 两个副本同时在线；健康检查失败（/api/health 非 2xx，例如数据库不可达或正在发布）即摘除
	reverse_proxy api-blue:8787 api-green:8787 {
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /api/health
		health_interval 5s
		health_timeout 4s
		health_status 2xx
		fail_duration 10s
		max_fails 1
		# SSE（执行链进度流）不缓冲
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}
